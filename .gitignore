# ==============================================================================
# GITIGNORE - SISTEMA ANIMATRÓNICO INTELIGENTE
# ==============================================================================

# Archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Archivos de audio generados dinámicamente y caché
server_pc/audio/*.mp3
server_pc/audio/*.wav
server_pc/audio_cache/
!server_pc/audio/.gitkeep

# Perfiles de voz y datos privados locales
server_pc/voicebox_profile/
voicebox_profile/
*.voicebox*
*.zip

# Binarios pesados
server_pc/bin/*.exe
server_pc/bin/cloudflared

# Archivos temporales de sistema operativo y editores
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# Documentos internos, reportes PDF y logs de depuración
*.pdf
*.log

# Artefactos de compilación intermedios
*.elf
*.map
build/
server_pc/models/
server_pc/certs/
server_pc/data/unified-runtime.json
**/build/
